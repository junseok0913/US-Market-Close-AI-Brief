# ====================================
# Gemini API Configuration
# ====================================

# Google AI Studio API Key (required)
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 기본 설정 (모든 에이전트 공통 기본값)
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TEMPERATURE=0.0
GEMINI_TIMEOUT=120
GEMINI_MAX_RETRIES=2

# OpeningAgent 전용 오버라이드
OPENING_GEMINI_MODEL=
OPENING_GEMINI_TEMPERATURE=
OPENING_GEMINI_TIMEOUT=
OPENING_GEMINI_MAX_RETRIES=

# ThemeAgent 전용 오버라이드 (Worker/Refiner 분리)
THEME_WORKER_GEMINI_MODEL=
THEME_WORKER_GEMINI_TEMPERATURE=
THEME_WORKER_GEMINI_TIMEOUT=
THEME_WORKER_GEMINI_MAX_RETRIES=

THEME_REFINER_GEMINI_MODEL=
THEME_REFINER_GEMINI_TEMPERATURE=
THEME_REFINER_GEMINI_TIMEOUT=
THEME_REFINER_GEMINI_MAX_RETRIES=

# ClosingAgent 전용 오버라이드
CLOSING_GEMINI_MODEL=
CLOSING_GEMINI_TEMPERATURE=
CLOSING_GEMINI_TIMEOUT=
CLOSING_GEMINI_MAX_RETRIES=

# 슬라이드 생성 (선택)
SLIDE_GEMINI_MODEL=
SLIDE_GEMINI_TEMPERATURE=

# 팟캐스트 메타데이터 생성 (선택)
PODCAST_METADATA_GEMINI_MODEL=
PODCAST_METADATA_GEMINI_TEMPERATURE=
